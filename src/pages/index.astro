---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FichaBuild from '../components/FichaBuild.astro';
import ItemPatch from '../components/ItemPatch.astro';
import Carimbo from '../components/Carimbo.astro';
import Retrato from '../components/Retrato.astro';
import Sigilo from '../components/Sigilo.astro';
import estado from '../data/estado.json';
import { url, fmtData, diasDesde, STATUS, type StatusBuild } from '../lib/util';

const builds = (await getCollection('builds')).sort((a, b) => +b.data.auditadaEm - +a.data.auditadaEm);
const patches = (await getCollection('patches')).sort((a, b) => +b.data.data - +a.data.data);
const major = estado.ultimoMajor;
const ultimo = patches[0];
const balanco = patches.find((p) => p.data.sobe.length || p.data.desce.length);
const conta = (s: StatusBuild) => builds.filter((b) => b.data.status === s).length;
---
<Base>
  <section class="manchete" aria-labelledby="pergunta">
    <p class="chapeu">
      <span class="etiqueta etiqueta--sangue">Estado do jogo</span>
      <span class="rubrica">Atualizado em {fmtData(estado.atualizadoEm)}</span>
    </p>
    <h1 id="pergunta">{estado.pergunta}</h1>
    <p class={`veredito veredito--${estado.humor}`}>{estado.veredito}</p>
    <p class="linha-fina">{estado.linhaFina}</p>
  </section>

  <div class="colunas">
    <section class="placa-wrap" aria-labelledby="t-placa">
      <div class="placa">
        <p class="placa-topo" id="t-placa"><Sigilo tamanho={20} /> Aviso à população <Sigilo tamanho={20} /></p>
        <p class="placa-frase">A Cidade está há</p>
        <div class="relogio dado" data-desde={major.data} role="timer" aria-label="Tempo desde o último patch grande">
          <span><b data-u="d">{diasDesde(major.data)}</b><small>dias</small></span>
          <span><b data-u="h">00</b><small>horas</small></span>
          <span><b data-u="m">00</b><small>min</small></span>
          <span><b data-u="s">00</b><small>seg</small></span>
        </div>
        <p class="placa-frase">sem patch grande</p>
      </div>
      <dl class="ficha-patch">
        <div><dt>Último grande</dt><dd><a href={url(`/patches/${major.patch}/`)}>{major.nome}</a> · {fmtData(major.data)}</dd></div>
        {ultimo && (
          <div><dt>Último update</dt><dd><a href={url(`/patches/${ultimo.id}/`)}>{ultimo.data.titulo}</a> · há {diasDesde(ultimo.data.data)} dias</dd></div>
        )}
      </dl>
    </section>

    {balanco && (
      <section class="sobe-desce" aria-labelledby="t-sd">
        <h2 id="t-sd">Sobe <span>&</span> Desce</h2>
        <p class="rubrica">Pelo {balanco.data.titulo} de {fmtData(balanco.data.data, { year: undefined })}</p>
        <div class="lado lado--sobe">
          <h3><span aria-hidden="true">▲</span> Sobe</h3>
          <ul>{balanco.data.sobe.map((h) => <li><Retrato heroi={h} tamanho={30} />{h}</li>)}</ul>
        </div>
        <div class="lado lado--desce">
          <h3><span aria-hidden="true">▼</span> Desce</h3>
          <ul>{balanco.data.desce.map((h) => <li><Retrato heroi={h} tamanho={30} />{h}</li>)}</ul>
        </div>
        <a class="dado mais" href={url(`/patches/${balanco.id}/`)}>O que mudou em cada um →</a>
      </section>
    )}
  </div>

  <section class="secao" aria-labelledby="t-builds">
    <div class="secao-topo">
      <h2 id="t-builds">Na mesa do cartório</h2>
      <a href={url('/builds/')}>Todas as builds →</a>
    </div>
    <p class="placar">
      {(Object.keys(STATUS) as StatusBuild[]).map((s) => (
        <span><Carimbo status={s} /> <b class="dado">{conta(s)}</b></span>
      ))}
    </p>
    <div class="fichas">
      {builds.slice(0, 6).map((b) => <FichaBuild build={b} />)}
    </div>
  </section>

  <div class="colunas colunas--pe">
    <section class="secao" aria-labelledby="t-patches">
      <div class="secao-topo">
        <h2 id="t-patches">Arquivo de patches</h2>
        <a href={url('/patches/')}>Todos →</a>
      </div>
      <ol class="lista">{patches.slice(0, 3).map((p) => <ItemPatch patch={p} />)}</ol>
    </section>

    <section class="secao" aria-labelledby="t-selo">
      <div class="quadro">
        <h2 id="t-selo">O que é o carimbo</h2>
        <ol>
          <li><b>Alguém joga de verdade.</b> A build roda em partidas reais no patch em vigor.</li>
          <li><b>Outra pessoa confere.</b> Quem audita nunca é quem escreveu.</li>
          <li><b>Saiu patch, volta pra mesa.</b> Build afetada perde o carimbo até ser testada de novo.</li>
        </ol>
        <a class="dado mais" href={url('/regulamento/')}>Regulamento completo →</a>
      </div>
    </section>
  </div>
</Base>

<script>
  const el = document.querySelector<HTMLElement>('[data-desde]');
  if (el) {
    const desde = new Date(el.dataset.desde!).getTime();
    const [d, h, m, s] = ['d', 'h', 'm', 's'].map((k) => el.querySelector(`[data-u="${k}"]`)!);
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      let t = Math.max(0, Math.floor((Date.now() - desde) / 1000));
      d.textContent = String(Math.floor(t / 86400));
      t %= 86400;
      h.textContent = pad(Math.floor(t / 3600));
      m.textContent = pad(Math.floor((t % 3600) / 60));
      s.textContent = pad(t % 60);
    };
    tick();
    setInterval(tick, 1000);
  }
</script>

<style>
  .manchete { text-align: center; padding-block: 1.5rem 1.75rem; border-block-end: 1px solid var(--tinta); }
  .chapeu { display: flex; justify-content: center; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin: 0 0 0.75rem; }
  .chapeu .rubrica { margin: 0; }
  h1 { font: italic 400 clamp(1.3rem, 3vw, 1.9rem) / 1.2 var(--f-texto); color: var(--tinta-2); }
  .veredito {
    margin: 0.15rem 0 0.5rem;
    font: 400 clamp(3.4rem, 12vw, 8.5rem) / 0.92 var(--f-manchete);
    text-transform: uppercase;
  }
  .veredito--agitado { color: var(--ambar); }
  .veredito--caos { color: var(--sangue); }
  .linha-fina { margin: 0 auto; max-inline-size: 56ch; font-size: clamp(1.05rem, 2.2vw, 1.3rem); line-height: 1.4; }

  .colunas { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 0 2rem; }
  .colunas > * + * { border-inline-start: 1px solid var(--fio); padding-inline-start: 2rem; }
  .colunas--pe { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); }
  @media (max-width: 820px) {
    .colunas, .colunas--pe { grid-template-columns: 1fr; }
    .colunas > * + * { border-inline-start: 0; padding-inline-start: 0; }
  }

  .placa-wrap { padding-block: 1.75rem; }
  .placa {
    margin: 5px;
    padding: 0 1rem 1.2rem;
    background: var(--papel-2);
    border: 4px solid var(--tinta);
    outline: 2px solid var(--tinta);
    outline-offset: 3px;
    text-align: center;
  }
  .placa-topo {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    margin: 0 -1rem 0.9rem;
    padding: 0.35rem;
    background: var(--tinta);
    color: var(--papel);
    font: 700 1.5rem/1.1 var(--f-titulo);
  }
  .placa-topo :global(.sigilo) { color: var(--ambar); }
  .placa-frase { margin: 0.2rem 0; font: 400 clamp(1.2rem, 3vw, 1.6rem) / 1.1 var(--f-manchete); text-transform: uppercase; }
  .relogio { display: flex; justify-content: center; gap: 0.4rem; margin-block: 0.5rem; }
  .relogio span { display: grid; gap: 0.2rem; }
  .relogio b {
    display: block;
    min-inline-size: 2.1ch;
    padding: 0.05em 0.2em;
    background: var(--sangue);
    color: var(--sobre-escuro);
    font-size: clamp(2.1rem, 7vw, 3.6rem);
    font-weight: 700;
    line-height: 1.1;
  }
  .relogio span:not(:first-child) b { background: var(--tinta); color: var(--papel); }
  .relogio small { font-size: 0.66rem; text-transform: uppercase; color: var(--tinta-3); }

  .ficha-patch { margin: 1rem 0 0; display: grid; gap: 0.35rem; font-size: 0.95rem; }
  .ficha-patch div { display: flex; gap: 0.75rem; border-block-end: 1px dotted var(--fio); padding-block-end: 0.3rem; }
  .ficha-patch dt { flex: none; inline-size: 7.5rem; font: 700 0.74rem/1.9 var(--f-dado); text-transform: uppercase; color: var(--tinta-3); }
  .ficha-patch dd { margin: 0; }

  .sobe-desce { padding-block: 1.75rem; }
  .sobe-desce h2 { font: 400 2.2rem/1 var(--f-manchete); text-transform: uppercase; }
  .sobe-desce h2 span { font: 700 1em var(--f-titulo); color: var(--ambar); }
  .lado { margin-block-start: 0.9rem; }
  .lado h3 { font: 700 0.85rem var(--f-dado); text-transform: uppercase; padding-block-end: 0.3rem; border-block-end: 2px solid currentColor; }
  .lado--sobe h3 { color: var(--ambar); }
  .lado--desce h3 { color: var(--safira); }
  .lado ul { margin: 0.5rem 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; }
  .lado li { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; font-size: 0.98rem; }
  .mais { display: inline-block; margin-block-start: 1rem; font-size: 0.8rem; text-transform: uppercase; }

  .placar { display: flex; flex-wrap: wrap; gap: 0.75rem 1.75rem; margin: -0.25rem 0 1.25rem; }
  .placar span { display: inline-flex; align-items: center; gap: 0.6rem; }
  .placar b { font-size: 1.5rem; }
  .fichas { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr)); }

  .lista { margin: 0; padding: 0; list-style: none; }
  .lista :global(.patch:first-child) { padding-block-start: 0; }

  .quadro { border: 2px solid var(--tinta); outline: 1px solid var(--tinta); outline-offset: 3px; padding: 1.1rem 1.25rem; margin: 4px; background: var(--papel-2); }
  .quadro h2 { font: 700 2rem/1.05 var(--f-titulo); }
  .quadro ol { margin: 0.9rem 0 0; padding-inline-start: 1.2rem; display: grid; gap: 0.6rem; font-size: 0.98rem; }
  .quadro b { font-weight: 600; }
</style>
