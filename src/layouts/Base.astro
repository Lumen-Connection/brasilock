---
import '../styles/global.css';
import Sigilo from '../components/Sigilo.astro';
import estado from '../data/estado.json';
import { url, fmtDataLonga, diasDesde } from '../lib/util';

interface Props { titulo?: string; descricao?: string }
const {
  titulo,
  descricao = 'O jornal da Cidade para jogadores brasileiros de Deadlock: builds auditadas, patches em português e o estado do jogo.',
} = Astro.props;
const tituloFinal = titulo ? `${titulo} · Brasilock` : 'Brasilock · Deadlock em português';
const rota = Astro.url.pathname;
const capa = rota === url('/');
const nav = [
  { href: '/', rotulo: 'Capa' },
  { href: '/builds/', rotulo: 'Builds auditadas' },
  { href: '/patches/', rotulo: 'Patches' },
  { href: '/regulamento/', rotulo: 'Regulamento' },
];
const ativo = (h: string) => (h === '/' ? capa : rota.startsWith(url(h)));
const diasSemMajor = diasDesde(estado.ultimoMajor.data);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloFinal}</title>
    <meta name="description" content={descricao} />
    <meta property="og:title" content={tituloFinal} />
    <meta property="og:description" content={descricao} />
    <meta name="theme-color" content="#ebe1c9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1211" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Courier+Prime:wght@400;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Grenze+Gotisch:wght@700..900&display=swap"
    />
  </head>
  <body>
    <a class="visually-hidden" href="#conteudo">Pular para o conteúdo</a>

    <header class="cabecalho">
      <div class="container">
        <div class="faixa-edicao dado">
          <span>Edição nº {estado.edicao}</span>
          <span class="data">{fmtDataLonga(estado.atualizadoEm)}</span>
          <span>Preço: 0 almas</span>
        </div>

        <div class:list={['frontispicio', { 'frontispicio--capa': capa }]}>
          <div class="orelha">
            <span class="rubrica">Patch em vigor</span>
            <b>{estado.patchAtual}</b>
          </div>
          <a class="logo" href={url('/')} aria-label="Brasilock, capa">Brasilock</a>
          <div class="orelha orelha--direita">
            <span class="rubrica">Dias sem patch grande</span>
            <b class="dado" data-dias-desde={estado.ultimoMajor.data}>{diasSemMajor}</b>
          </div>
        </div>

        <p class="lema"><Sigilo tamanho={18} /> O jornal da Cidade para jogadores brasileiros de Deadlock <Sigilo tamanho={18} /></p>

        <nav aria-label="Seções">
          <ul>
            {nav.map((n) => (
              <li><a href={url(n.href)} aria-current={ativo(n.href) ? 'page' : undefined}>{n.rotulo}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="conteudo">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="rodape">
      <div class="container">
        <p class="logo-rodape">Brasilock</p>
        <p>Feito por jogadores brasileiros, de graça, para a comunidade.</p>
        <p>Não é afiliado à Valve. Deadlock, heróis e itens são da Valve; os textos e as builds são nossos.</p>
      </div>
    </footer>
    <script>
      document.querySelectorAll<HTMLElement>("[data-dias-desde]").forEach((el) => {
        el.textContent = String(Math.floor((Date.now() - +new Date(el.dataset.diasDesde!)) / 86400000));
      });
    </script>
  </body>
</html>

<style>
  .cabecalho { padding-block-start: 0.75rem; }
  .faixa-edicao {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.35rem;
    border-block: 1px solid var(--tinta);
    font-size: 0.74rem;
    text-transform: uppercase;
    color: var(--tinta-2);
  }

  .frontispicio {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 0.4rem 0;
  }
  .orelha {
    justify-self: start;
    display: grid;
    gap: 0.1rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--tinta);
    outline: 1px solid var(--tinta);
    outline-offset: 2px;
    text-align: center;
    max-inline-size: 11rem;
  }
  .orelha--direita { justify-self: end; }
  .orelha .rubrica { margin: 0; font-size: 0.62rem; }
  .orelha b { font: 600 0.98rem/1.15 var(--f-texto); }
  .orelha b.dado { font: 700 1.8rem/1 var(--f-dado); color: var(--sangue); }

  .logo {
    font: 800 clamp(2.8rem, 8vw, 4.4rem) / 1 var(--f-titulo);
    text-decoration: none;
    color: var(--tinta);
    text-align: center;
    white-space: nowrap;
  }
  .frontispicio--capa .logo { font-size: clamp(3.2rem, 12vw, 8.5rem); }
  .logo:hover { color: var(--tinta); }

  .lema {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    margin: 0.35rem 0 0.6rem;
    font-style: italic;
    color: var(--tinta-2);
    font-size: 1rem;
    text-align: center;
  }
  .lema :global(.sigilo) { flex: none; color: var(--ambar); }

  nav {
    border-block: 3px solid var(--tinta);
    box-shadow: 0 3px 0 -2px var(--papel), 0 5px 0 -2px var(--tinta);
    margin-block-end: 5px;
  }
  nav ul { display: flex; justify-content: center; margin: 0; padding: 0; list-style: none; }
  nav li + li { border-inline-start: 1px solid var(--fio); }
  nav a {
    display: block;
    padding: 0.5rem 1.1rem;
    font: 700 0.82rem var(--f-dado);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  nav a[aria-current='page'] { background: var(--tinta); color: var(--papel); }

  @media (max-width: 760px) {
    .faixa-edicao .data { display: none; }
    .frontispicio { grid-template-columns: 1fr 1fr; }
    .logo { grid-column: 1 / -1; grid-row: 1; }
    .orelha { max-inline-size: none; inline-size: 100%; }
    .lema { font-size: 0.9rem; }
    nav { overflow-x: auto; }
    nav ul { justify-content: flex-start; }
    nav a { padding-inline: 0.75rem; }
  }

  .rodape {
    border-block-start: 5px solid var(--tinta);
    padding-block: 1.5rem 2.5rem;
    font-size: 0.92rem;
    color: var(--tinta-2);
  }
  .rodape p { margin: 0.25rem 0; max-inline-size: 70ch; }
  .logo-rodape { font: 800 2.2rem/1 var(--f-titulo); color: var(--tinta); margin-block-end: 0.5rem !important; }
</style>
